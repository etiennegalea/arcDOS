# Copy to .env and pass it to Docker with --env-file .env.
# The stock docker-compose.yml runs the status service and does not load these settings into the container.
# See docs/deployment/authentik.md for the provider and bind mounts.

ARCDOS_DATA_DIR=/data

# Use the HTTPS URL printed by Tailscale Serve, without a trailing slash or path.
# Register the same URL plus /auth/callback as the strict redirect URI in Authentik.
ARCDOS_PUBLIC_ORIGIN=https://arcdos.example-tailnet.ts.net

# Copy the exact issuer from Authentik's discovery document, including the trailing slash.
ARCDOS_OIDC_ISSUER=https://auth.example.com/application/o/arcdos-web/
ARCDOS_OIDC_CLIENT_ID=replace-with-web-client-id

# Container path for the read-only secret mount. Keep the secret itself in a separate file.
ARCDOS_OIDC_CLIENT_SECRET_FILE=/run/arcdos-oidc-secret
